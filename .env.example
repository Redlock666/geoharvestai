# Environment — copy to .env and fill in values
# For local development (scripts running outside Docker):
#   POSTGRES_HOST=localhost  POSTGRES_PORT=5432
#   TIMESCALE_HOST=localhost TIMESCALE_PORT=5433
# For Docker Compose services talking to each other:
#   POSTGRES_HOST=db         TIMESCALE_HOST=timescaledb

POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=geoharvestai

# TimescaleDB (same credentials, different host/port)
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=geoharvestai_ts

# External APIs — LLM + Satellite
OPENAI_API_KEY=sk-...
# Reasoning model — default is o3. Set to gpt-5.4 / gpt-5.5 etc. if available.
OPENAI_REASONING_MODEL=o3
# Set to 'chat' if using a GPT-5.x chat model (re-enables temperature param).
OPENAI_MODEL_FAMILY=reasoning
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# ERA5 / Copernicus CDS API — register free at cds.climate.copernicus.eu
# Format: {uid}:{api-key}
CDSAPI_KEY=

# OpenTopography — SRTM terrain download (free registration at opentopography.org)
OPENTOPOGRAPHY_API_KEY=

# NASA EarthData — MODIS NDVI download (free registration at urs.earthdata.nasa.gov)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
